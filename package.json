{
  "name": "@seventhingscompany/customer-api",
  "version": "1.0.0",
  "description": "TypeScript client for the seventhings Customer API",
  "license": "MIT",
  "author": "Henry Rausch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seventhingsCompany/customer-api-typescript.git"
  },
  "homepage": "https://github.com/seventhingsCompany/customer-api-typescript#readme",
  "bugs": {
    "url": "https://github.com/seventhingsCompany/customer-api-typescript/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "seventhings",
    "customer-api",
    "sdk",
    "asset-tracking"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:package": "npm run build && publint && attw --pack .",
    "prepublishOnly": "npm run typecheck && npm test && npm run check:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
